{
  "name": "cbe-bloodconnect",
  "version": "1.0.0",
  "private": true,
  "description": "CBE BloodConnect - Coimbatore Blood Donor & Emergency Blood Request Management System (MCA Mini Project)",
  "scripts": {
    "preinstall": "rm -rf node_modules server/node_modules client/node_modules",
    "build": "cd client && npm install && npm run build",
    "install:server": "cd server && npm install",
    "install:client": "cd client && npm install",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "start": "cd server && npm start",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build:client": "cd client && npm run build"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0"
  },
  "keywords": ["blood-donor", "coimbatore", "react", "nodejs", "express", "mongodb", "mca"],
  "license": "MIT",
  "allowScripts": {
    "mongodb-memory-server": true,
    "esbuild": true
  }
}
